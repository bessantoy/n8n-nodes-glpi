{
  "name": "@bessantoy/n8n-nodes-glpi",
  "version": "0.1.0",
  "description": "n8n community nodes for the GLPI REST API: a generic node covering every endpoint, plus AI Agent / MCP tools to search and call endpoints dynamically.",
  "keywords": [
    "n8n-community-node-package",
    "glpi",
    "itsm",
    "helpdesk",
    "ai-agent",
    "mcp"
  ],
  "license": "MIT",
  "homepage": "https://github.com/bessantoy/n8n-nodes-glpi",
  "author": {
    "name": "Anthony Bessieres",
    "email": "anthony.bessieres@it-gouvernance.fr"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bessantoy/n8n-nodes-glpi.git"
  },
  "main": "index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials scripts --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "generate:index": "node scripts/generate-endpoint-index.js",
    "generate:schemas": "node scripts/generate-schemas-index.js",
    "validate:endpoints": "node scripts/validate-endpoint-update.js",
    "prepublishOnly": "npm run build && npm run validate:endpoints"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/GlpiOAuth2Api.credentials.js",
      "dist/credentials/GlpiPasswordApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Glpi/Glpi.node.js",
      "dist/nodes/GlpiFindEndpoint/GlpiFindEndpoint.node.js",
      "dist/nodes/GlpiExecuteEndpoint/GlpiExecuteEndpoint.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.0",
    "gulp": "^4.0.2",
    "n8n-workflow": "^1.60.0",
    "prettier": "^3.3.0",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
